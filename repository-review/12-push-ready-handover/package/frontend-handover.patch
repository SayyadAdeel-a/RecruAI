+      nextInterview={nextInterview}
+      countdownTo={countdownTo}
+      recentJobs={recentJobs}
+      popularJobs={popularJobs}
+      topCompanies={topCompanies}
+      timeAgo={timeAgo}
+      formatSalary={formatSalary}
+      navigate={navigate}
+    />
+  );
+}
