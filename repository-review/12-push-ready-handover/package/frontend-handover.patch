+    box-shadow: inset 0 calc(var(--ps) * -2.9) calc(var(--ps) * 7.2) rgba(0, 0, 0, 0.45);
+  }
+
+  .ss-phone__screen {
+    --pt: 1px;
+    position: absolute;
+    top: 0;
+    left: 0;
