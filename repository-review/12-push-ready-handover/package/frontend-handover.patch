-      if (result && result.data) {
-        setData((prev) => [...prev, ...result.data]);
-        setHasMore(result.hasMore || false);
-        setPage((prev) => prev + 1);
-      } else {
-        setHasMore(false);
-      }
-    } catch (err) {
-      setError(err.message || "Failed to load data");
-    } finally {
-      setLoading(false);
-    }
