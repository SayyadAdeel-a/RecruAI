diff --git a/frontend/src/stageshow/chart.css b/frontend/src/stageshow/chart.css
new file mode 100644
index 0000000..86c8048
--- /dev/null
+++ b/frontend/src/stageshow/chart.css
@@ -0,0 +1,59 @@
+/* Chart (chart.tsx). */
+
+@layer stageshow {
+  .ss-chart {
+    display: block;
+    overflow: visible;
+  }
+
+  /* Draws in: a wipe over the line and its fill, led by the dot riding the
+     curve at the wipe's edge (Chart drives both on one timeline, through an SVG
+     clip rect in the chart's own units). Hiding fades the whole chart at once. */
+  .ss-chart__draw {
+    opacity: 0;
+    transition: opacity 0.25s ease;
+  }
+
+  .ss-chart[data-show] .ss-chart__draw {
+    opacity: 1;
+    transition: opacity 0.15s ease;
+  }
+
+  .ss-chart__line {
+    fill: none;
+    stroke: var(--ss-accent);
+    stroke-width: 2;
+    stroke-linecap: round;
+    stroke-linejoin: round;
+    transition: d 0.8s cubic-bezier(0.45, 0, 0.2, 1);
+  }
+
+  .ss-chart__area {
+    transition: d 0.8s cubic-bezier(0.45, 0, 0.2, 1);
+  }
+
+  .ss-chart__dot {
+    fill: var(--ss-accent);
+    stroke: var(--ss-surface);
+    stroke-width: 2;
+    opacity: 0;
+    transform: scale(0.4);
+    transform-box: fill-box;
+    transform-origin: center;
+    transition: opacity 0.2s ease, transform 0.2s ease, cx 0.8s cubic-bezier(0.45, 0, 0.2, 1), cy 0.8s cubic-bezier(0.45, 0, 0.2, 1);
+  }
+
+  .ss-chart[data-show] .ss-chart__dot {
+    opacity: 1;
+    transform: none;
+  }
+
+  .ss-chart__bar {
+    fill: var(--ss-accent);
+    transition: y 0.7s cubic-bezier(0.25, 0.8, 0.25, 1), height 0.7s cubic-bezier(0.25, 0.8, 0.25, 1);
+  }
+
+  .ss-chart[data-still] * {
+    transition: none !important;
+  }
+}
diff --git a/frontend/src/stageshow/chart.tsx b/frontend/src/stageshow/chart.tsx
new file mode 100644
index 0000000..a444ba6
--- /dev/null
+++ b/frontend/src/stageshow/chart.tsx
@@ -0,0 +1,221 @@
+import { useId, useLayoutEffect, useRef, type CSSProperties } from 'react'
+import { useReducedMotion } from './reduced-motion'
+import './chart.css'
+
+// Charts drawn the way product dashboards draw them: a smooth line with a
+// soft area and an end dot, or rounded bars. They draw in when shown and
+// ease between values when the data changes.
+
+export interface ChartProps {
+  data: number[]
+  kind?: 'line' | 'bars'
+  width: number
+  height: number
+  /** Draws in when it turns true. */
+  show?: boolean
+  /** The soft fill under a line. */
+  area?: boolean
+  /** A dot on the last point. */
+  dot?: boolean
+  /** The value at the top of the chart. Defaults to the data's maximum. */
+  max?: number
+  className?: string
+  style?: CSSProperties
+}
+
+/**
+ * Where a Chart with these props draws each point, in its own pixels: a
+ * line's points (the end dot sits on the last), or the top center of each
+ * bar. For a tooltip, a marker or a hairline on a point, so nothing repeats
+ * the chart's maths. Add the chart's offset in its container.
+ */
+export function chartPoints({ data, kind = 'line', width, height, dot = true, max }: Pick<ChartProps, 'data' | 'kind' | 'width' | 'height' | 'dot' | 'max'>) {
+  const top = max ?? Math.max(...data, 1)
+  const pad = kind === 'line' && dot ? 4 : 1
+  const h = height - pad * 2
+  if (kind === 'bars') {
+    const gap = Math.max(2, Math.round(width / data.length / 4))
+    const bw = (width - gap * (data.length - 1)) / data.length
+    return data.map((v, i) => ({ x: i * (bw + gap) + bw / 2, y: height - Math.max(2, (v / top) * h) }))
+  }
+  return data.map((v, i) => ({ x: pad + (i / Math.max(1, data.length - 1)) * (width - pad * 2), y: pad + h - (v / top) * h }))
+}
+
+/** A smooth path through the points (Catmull-Rom as cubic Béziers), never overshooting the ends. */
+function smooth(p: { x: number; y: number }[]) {
+  if (!p.length) return ''
+  let d = `M${p[0].x} ${p[0].y}`
+  for (let i = 0; i < p.length - 1; i++) {
+    const a = p[i - 1] ?? p[i]
+    const b = p[i]
+    const c = p[i + 1]
+    const e = p[i + 2] ?? c
+    d += `C${b.x + (c.x - a.x) / 6} ${b.y + (c.y - a.y) / 6} ${c.x - (e.x - b.x) / 6} ${c.y - (e.y - b.y) / 6} ${c.x} ${c.y}`
+  }
+  return d
+}
+
+/**
+ * The same curve as smooth(), sampled at a fixed number of points. A path
+ * only eases into another with the same commands, so a line drawn from 8
+ * points and one from 9 would swap in a frame while the dot traveled.
+ * Sampling keeps every line the same shape of path, whatever the data's length.
+ */
+const SAMPLES = 48
+
+/** The draw-in's timing: the same curve the rest of the kit's travel uses. */
+const DRAW_MS = 1200
+function ease(t: number) {
+  // cubic-bezier(0.45, 0, 0.2, 1), solved for x by bisection
+  const b = (a: number, c: number, u: number) => 3 * a * u * (1 - u) ** 2 + 3 * c * u * u * (1 - u) + u ** 3
+  let lo = 0
+  let hi = 1
+  for (let i = 0; i < 20; i++) {
+    const m = (lo + hi) / 2
+    if (b(0.45, 0.2, m) < t) lo = m
+    else hi = m
+  }
+  return b(0, 1, (lo + hi) / 2)
+}
+
+/** The curve's height at x, from its sampled points. */
+function yAt(p: { x: number; y: number }[], x: number) {
+  let i = 1
+  while (i < p.length - 1 && p[i].x < x) i++
+  const a = p[i - 1]
+  const c = p[i]
+  const t = c.x === a.x ? 0 : Math.max(0, Math.min(1, (x - a.x) / (c.x - a.x)))
+  return a.y + (c.y - a.y) * t
+}
+
+function resample(p: { x: number; y: number }[]) {
+  if (p.length < 2) return p
+  const out: { x: number; y: number }[] = []
+  for (let s = 0; s <= SAMPLES; s++) {
+    const u = (s / SAMPLES) * (p.length - 1)
+    const i = Math.min(Math.floor(u), p.length - 2)
+    const t = u - i
+    const a = p[i - 1] ?? p[i]
+    const b = p[i]
+    const c = p[i + 1]
+    const e = p[i + 2] ?? c
+    // The Bézier segment smooth() draws between b and c
+    const c1 = { x: b.x + (c.x - a.x) / 6, y: b.y + (c.y - a.y) / 6 }
+    const c2 = { x: c.x - (e.x - b.x) / 6, y: c.y - (e.y - b.y) / 6 }
+    const m = 1 - t
+    const k = (p0: number, p1: number, p2: number, p3: number) => m * m * m * p0 + 3 * m * m * t * p1 + 3 * m * t * t * p2 + t * t * t * p3
+    out.push({ x: k(b.x, c1.x, c2.x, c.x), y: k(b.y, c1.y, c2.y, c.y) })
+  }
+  return out
+}
+
+/**
+ * A line or bar chart in a fixed box. A sparkline is a small line with no
+ * area or dot. Values change by easing the shape (the line morphs, bars grow),
+ * never by redrawing.
+ */
+export function Chart({ data, kind = 'line', width, height, show = true, area = true, dot = true, max, className, style }: ChartProps) {
+  const reduced = useReducedMotion()
+  const id = useId().replace(/:/g, '')
+  const drawRef = useRef<SVGGElement>(null)
+  const wipeRef = useRef<SVGRectElement>(null)
+  const dotRef = useRef<SVGCircleElement>(null)
+  const samples = useRef<{ x: number; y: number }[]>([])
+  const shown = useRef(false)
+  // Draw-in: the dot leads and the line follows it. One timeline moves the
+  // wipe's edge and puts the dot on the curve at that edge, every frame.
+  useLayoutEffect(() => {
+    const was = shown.current
+    const g = drawRef.current
+    shown.current = show && data.length > 1 && !!g
+    if (!show || was || !g) return
+    const c = dotRef.current
+    const p = samples.current
+    if (reduced || p.length < 2) return
+    const x0 = p[0].x
+    const x1 = p[p.length - 1].x
+    const wipe = wipeRef.current
+    if (!wipe) return
+    // The clip is a rect in the chart's own units, so its edge is exactly the dot's x
+    const at = (e: number) => {
+      const x = x0 + (x1 - x0) * e
+      wipe.setAttribute('width', `${x + 6}`)
+      if (c) {
+        c.style.setProperty('cx', `${x}px`)
+        c.style.setProperty('cy', `${yAt(p, x)}px`)
+      }
+    }
+    g.style.transition = 'opacity 0.15s ease'
+    if (c) {
+      c.style.transition = 'opacity 0.2s ease, transform 0.3s cubic-bezier(0.34, 1.4, 0.64, 1)'
+      c.style.opacity = '1'
+      c.style.transform = 'none'
+    }
+    at(0)
+    const t0 = performance.now()
+    let drawing = true
+    let raf = requestAnimationFrame(function step(now) {
+      const t = Math.min(1, (now - t0) / DRAW_MS)
+      at(ease(t))
+      if (t < 1) raf = requestAnimationFrame(step)
+      else done()
+    })
+    // Back to the stylesheet: the end state matches it, so nothing moves
+    const done = () => {
+      drawing = false
+      wipe.setAttribute('width', `${width + 12}`)
+      g.style.removeProperty('transition')
+      if (c) for (const k of ['cx', 'cy', 'transition', 'opacity', 'transform']) c.style.removeProperty(k)
+    }
+    return () => {
+      cancelAnimationFrame(raf)
+      // An interrupted setup (including StrictMode's rehearsal) can draw
+      // again. A completed draw does not replay when motion is restored.
+      if (drawing) shown.current = false
+      done()
+    }
+  }, [show, reduced, kind, width, data.length > 1]) // eslint-disable-line react-hooks/exhaustive-deps
+  const top = max ?? Math.max(...data, 1)
+  const pad = kind === 'line' && dot ? 4 : 1
+  const h = height - pad * 2
+  if (!data.length) return <svg className={`ss-chart${className ? ` ${className}` : ''}`} data-kind={kind} data-show={show || undefined} width={width} height={height} style={style} aria-hidden />
+  if (kind === 'bars') {
+    const gap = Math.max(2, Math.round(width / data.length / 4))
+    const bw = (width - gap * (data.length - 1)) / data.length
+    return (
+      <svg className={`ss-chart${className ? ` ${className}` : ''}`} data-kind="bars" data-still={reduced || undefined} data-show={show || undefined} width={width} height={height} style={style} aria-hidden>
+        {data.map((v, i) => {
+          const bh = Math.max(2, (v / top) * h)
+          return <rect key={i} className="ss-chart__bar" x={i * (bw + gap)} width={bw} rx={Math.min(2, bw / 2)} style={{ y: height - (show ? bh : 0), height: show ? bh : 0, transitionDelay: `${i * 22}ms` } as CSSProperties} />
+        })}
+      </svg>
+    )
+  }
+  const pts = chartPoints({ data, kind, width, height, dot, max })
+  const curve = resample(pts)
+  samples.current = curve
+  const line = smooth(curve)
+  const fill = `${line}L${pts[pts.length - 1].x} ${height}L${pts[0].x} ${height}Z`
+  const end = pts[pts.length - 1]
+  return (
+    <svg className={`ss-chart${className ? ` ${className}` : ''}`} data-kind="line" data-still={reduced || undefined} data-show={show || undefined} width={width} height={height} style={style} aria-hidden>
+      <defs>
+        <linearGradient id={`${id}-fill`} x1="0" y1="0" x2="0" y2="1">
+          <stop offset="0" stopColor="var(--ss-accent)" stopOpacity="0.18" />
+          <stop offset="1" stopColor="var(--ss-accent)" stopOpacity="0" />
+        </linearGradient>
+        <clipPath id={`${id}-wipe`}>
+          <rect ref={wipeRef} x={-6} y={-6} width={width + 12} height={height + 12} />
+        </clipPath>
+      </defs>
+      {/* One wipe reveals the line and its fill together, so the fill never
+          runs ahead of the line. d is also set as a style so a data change
+          eases the shape */}
+      <g ref={drawRef} className="ss-chart__draw" clipPath={`url(#${id}-wipe)`}>
+        {area && pts.length > 1 && <path className="ss-chart__area" d={fill} style={{ d: `path("${fill}")` } as CSSProperties} fill={`url(#${id}-fill)`} />}
+        <path className="ss-chart__line" d={line} style={{ d: `path("${line}")` } as CSSProperties} />
+      </g>
+      {dot && <circle ref={dotRef} className="ss-chart__dot" data-lead="" cx={end.x} cy={end.y} r={3.5} style={{ cx: end.x, cy: end.y } as CSSProperties} />}
+    </svg>
+  )
+}
diff --git a/frontend/src/stageshow/clock.ts b/frontend/src/stageshow/clock.ts
new file mode 100644
index 0000000..e7cbb97
--- /dev/null
+++ b/frontend/src/stageshow/clock.ts
@@ -0,0 +1,265 @@
+// The stage clock. Everything on a stage moves on the browser's own clocks:
+// performance.now, requestAnimationFrame, setTimeout/setInterval, and CSS
+// transitions and animations on the compositor. With nothing attached, that
+// is all this file is: `clock` reads those same globals, so a stage plays in
+// real time exactly as it always has.
+//
+// A recorder or the playground runs installVirtualClock() in the page
+// before any of its code loads. From then on time only moves when the
+// recorder steps it, by exactly 1/fps: timers fire in time order, one
+// animation frame runs, and every CSS transition and animation is set to the
+// new time. Live playback instead calls advance() with the native RAF's
+// elapsed time, so its motion follows the display refresh rate. Each fixed
+// frame of a video is then the same on every render, a
+// timed beat lands on a known frame, and nothing drops or doubles.
+//
+// Chrome's own virtual time (Emulation.setVirtualTimePolicy) doesn't do this:
+// it moves timers but runs no animation frames and leaves CSS animations
+// where they are.
+
+/** What a recorder drives, at window.__stageshow.clock once installed. */
+export interface ClockControl {
+  readonly fps: number
+  /** Render updates since install; fixed frames when driven by step(). */
+  readonly frame: number
+  /** Virtual ms, what performance.now() returns. */
+  now(): number
+  /**
+   * Advance `frames` frames (1 by default). Per frame: timers due by the new
+   * time fire in order, each followed by the work it queued (React commits,
+   * promise chains); then one round of animation frames; then every CSS
+   * transition and animation is moved to the new time.
+   */
+  step(frames?: number): Promise<void>
+  /** Advance live playback by elapsed milliseconds, rendering one update. */
+  advance(milliseconds: number): Promise<void>
+  /** Let queued tasks run without moving time, and hold any CSS animation that started meanwhile. */
+  settle(): Promise<void>
+  /** Stage measurement callbacks, separate from motion frames. */
+  requestLayoutFrame(callback: FrameRequestCallback): number
+  cancelLayoutFrame(id: number): void
+  readonly layoutPending: boolean
+  /** Run one round of layout callbacks without advancing time, timers or motion. */
+  flushLayout(): Promise<void>
+}
+
+type Host = { __stageshow?: { clock?: ClockControl } }
+
+/**
+ * The clock the kit and its scenes read. Each call goes to the page's global
+ * at call time, so under a recorder it is the virtual clock and otherwise
+ * the real one.
+ */
+export const clock = {
+  now: (): number => performance.now(),
+  raf: (fn: FrameRequestCallback): number => requestAnimationFrame(fn),
+  cancelRaf: (id: number): void => cancelAnimationFrame(id),
+  // Layout must finish even when a preview is paused. Keep these callbacks
+  // separate: running arbitrary motion RAFs at a frozen timestamp can still
+  // advance a spring that integrates once per callback.
+  layoutRaf: (fn: FrameRequestCallback): number => clock.recording?.requestLayoutFrame(fn) ?? requestAnimationFrame(fn),
+  cancelLayoutRaf: (id: number): void => {
+    const recording = clock.recording
+    if (recording) recording.cancelLayoutFrame(id)
+    else cancelAnimationFrame(id)
+  },
+  timeout: (fn: () => void, ms: number): number => window.setTimeout(fn, ms),
+  clearTimeout: (id: number): void => window.clearTimeout(id),
+  /** The recorder's control while one drives the page, else null. */
+  get recording(): ClockControl | null {
+    return typeof window === 'undefined' ? null : ((window as unknown as Host).__stageshow?.clock ?? null)
+  },
+}
+
+/**
+ * Replace the page's clocks with a virtual one that only moves on step().
+ * Self-contained (a recorder can inject its source as an init script), so it
+ * must not reference anything outside its own body.
+ *
+ * `epoch` is the wall-clock time Date reports at frame 0, so a clock drawn
+ * in a scene reads the same on every render.
+ */
+export function installVirtualClock(opts: { fps?: number; epoch?: number; onLayout?: () => void } = {}): ClockControl {
+  const w = window as any
+  if (w.__stageshow?.clock) return w.__stageshow.clock
+  const fps = opts.fps ?? 60
+  const RealDate = Date
+  const epoch = opts.epoch ?? RealDate.now()
+  // Not 0: code that tests a timestamp for truthiness must still see one
+  const BASE = 1000
+  let vt = BASE
+  let frame = 0
+  let fixedAnchor = BASE
+  let fixedFrame = 0
+
+  type Timer = { id: number; at: number; seq: number; fn: unknown; args: unknown[]; every: number | null }
+  const timers = new Map<number, Timer>()
+  let nextId = 1
+  let seq = 0
+  let frameCbs = new Map<number, FrameRequestCallback>()
+  let layoutCbs = new Map<number, FrameRequestCallback>()
+
+  const arm = (fn: unknown, ms: unknown, args: unknown[], every: boolean) => {
+    const d = Math.max(0, Number(ms) || 0)
+    const id = nextId++
+    timers.set(id, { id, at: vt + d, seq: seq++, fn, args, every: every ? Math.max(1, d) : null })
+    return id
+  }
+  w.setTimeout = (fn: unknown, ms?: unknown, ...args: unknown[]) => arm(fn, ms, args, false)
+  w.setInterval = (fn: unknown, ms?: unknown, ...args: unknown[]) => arm(fn, ms, args, true)
+  w.clearTimeout = w.clearInterval = (id: number) => void timers.delete(id)
+  w.requestAnimationFrame = (fn: FrameRequestCallback) => {
+    const id = nextId++
+    frameCbs.set(id, fn)
+    return id
+  }
+  w.cancelAnimationFrame = (id: number) => void frameCbs.delete(id)
+  performance.now = () => vt
+  const dateNow = () => Math.floor(epoch + (vt - BASE))
+  const VDate = function (this: unknown, ...a: unknown[]) {
+    if (!new.target) return new RealDate(dateNow()).toString()
+    return a.length ? new (RealDate as any)(...a) : new RealDate(dateNow())
+  } as unknown as DateConstructor
+  Object.assign(VDate, { prototype: RealDate.prototype, now: dateNow, parse: RealDate.parse, UTC: RealDate.UTC })
+  w.Date = VDate
+
+  // Queued work (React renders on a MessageChannel, effects after them,
+  // promise chains) runs between tasks; a few message round trips let it all
+  // land before time moves on.
+  const tick = () =>
+    new Promise<void>((r) => {
+      const c = new MessageChannel()
+      c.port1.onmessage = () => {
+        c.port1.close()
+        c.port2.close()
+        r()
+      }
+      c.port2.postMessage(0)
+    })
+  // Anything that started meanwhile is held from here on (see scan below).
+  const settle = async () => {
+    for (let i = 0; i < 4; i++) await tick()
+    scan()
+  }
+  const run = (fn: unknown, args: unknown[]) => {
+    try {
+      // String callbacks are ignored: running them would need eval
+      if (typeof fn === 'function') fn(...args)
+    } catch (e) {
+      console.error(e)
+    }
+  }
+
+  // CSS transitions and animations: each one is held (playback rate 0) from
+  // the moment it is first seen, and its own clock is moved by hand with the
+  // virtual one. One that turned paused in CSS stays put; one that reaches its
+  // end is finished, so transitionend and animationend still fire.
+  type Held = { local: number; rate: number; born: number }
+  const held = new WeakMap<Animation, Held>()
+  const live = new Set<Animation>()
+  const scan = () => {
+    for (const a of document.getAnimations()) {
+      if (held.has(a) || a.playState === 'finished' || a.playState === 'idle') continue
+      held.set(a, { local: 0, rate: a.playbackRate || 1, born: vt })
+      a.playbackRate = 0
+      a.currentTime = 0
+      live.add(a)
+    }
+  }
+  const moveAnimations = (from: number) => {
+    scan()
+    for (const a of Array.from(live)) {
+      const h = held.get(a)!
+      if (a.playState === 'idle' || a.playState === 'finished') {
+        live.delete(a)
+        continue
+      }
+      if (a.playState !== 'paused') h.local += (vt - Math.max(from, h.born)) * h.rate
+      const end = a.effect?.getComputedTiming().endTime
+      if (typeof end === 'number' && Number.isFinite(end) && h.local >= end) {
+        // Cancel a pending play task before restoring the rate. Otherwise a
+        // delayed transition can restart on the native timeline after finish().
+        a.pause()
+        a.playbackRate = h.rate
+        a.finish()
+        live.delete(a)
+      } else {
+        a.currentTime = h.local
+      }
+    }
+  }
+
+  const stepTo = async (to: number) => {
+    const from = vt
+    await settle()
+    // Timers due by `to`, in time order, each with the work it queued. A
+    // hair of slack, so a wait summed from frame-sized steps can't miss its
+    // frame by a rounding error
+    for (let guard = 0; guard < 10000; guard++) {
+      let next: Timer | null = null
+      for (const t of Array.from(timers.values())) if (t.at <= to + 1e-6 && (!next || t.at < next.at || (t.at === next.at && t.seq < next.seq))) next = t
+      if (!next) break
+      vt = next.at
+      if (next.every === null) timers.delete(next.id)
+      else {
+        next.at += next.every
+        next.seq = seq++
+      }
+      run(next.fn, next.args)
+      await settle()
+    }
+    vt = to
+    frame++
+    const cbs = frameCbs
+    const layout = layoutCbs
+    frameCbs = new Map()
+    layoutCbs = new Map()
+    for (const fn of Array.from(layout.values())) run(fn, [vt])
+    for (const fn of Array.from(cbs.values())) run(fn, [vt])
+    await settle()
+    moveAnimations(from)
+  }
+
+  const control: ClockControl = {
+    fps,
+    get frame() {
+      return frame
+    },
+    now: () => vt,
+    async step(n = 1) {
+      // Keep recorder timestamps exact, without accumulating rounded deltas.
+      for (let i = 0; i < n; i++) await stepTo(fixedAnchor + (++fixedFrame * 1000) / fps)
+    },
+    async advance(milliseconds) {
+      if (!Number.isFinite(milliseconds) || milliseconds < 0) throw new RangeError('Clock advance must be a finite, non-negative duration')
+      if (milliseconds === 0) return
+      await stepTo(vt + milliseconds)
+      // A manual fixed step after live playback starts at the current time.
+      fixedAnchor = vt
+      fixedFrame = 0
+    },
+    settle,
+    requestLayoutFrame(callback) {
+      const empty = layoutCbs.size === 0
+      const id = nextId++
+      layoutCbs.set(id, callback)
+      // A paused React/ResizeObserver commit can enqueue measurement work
+      // without changing any observed DOM attributes. Wake its host directly.
+      if (empty) opts.onLayout?.()
+      return id
+    },
+    cancelLayoutFrame: (id) => void layoutCbs.delete(id),
+    get layoutPending() { return layoutCbs.size > 0 },
+    async flushLayout() {
+      await settle()
+      // Snapshot once: a nested layout frame belongs to the next native
+      // paint, rather than an unbounded drain in this task.
+      const callbacks = layoutCbs
+      layoutCbs = new Map()
+      for (const fn of Array.from(callbacks.values())) run(fn, [vt])
+      await settle()
+    },
+  }
+  w.__stageshow = { ...(w.__stageshow ?? {}), clock: control }
+  return control
+}
diff --git a/frontend/src/stageshow/code.css b/frontend/src/stageshow/code.css
new file mode 100644
