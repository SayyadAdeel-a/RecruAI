+++ b/frontend/src/stageshow/code.css
@@ -0,0 +1,87 @@
+/* Code (code.tsx). */
+
+@layer stageshow {
+  .ss-code {
+    --ss-code-key: #7c3aed;
+    --ss-code-str: #15803d;
+    --ss-code-num: #b45309;
+    --ss-code-fn: #2563eb;
+    font: 11.5px/19px ui-monospace, 'SF Mono', Menlo, monospace;
+    color: var(--ss-text-strong);
+  }
+
+  .ss-stage[data-theme="dark"] .ss-code {
+    --ss-code-key: #c4b5fd;
+    --ss-code-str: #86efac;
+    --ss-code-num: #fdba74;
+    --ss-code-fn: #93c5fd;
+  }
+
+  .ss-stage[data-palette="mono"] .ss-code,
+  .ss-stage[data-theme="blueprint"] .ss-code {
+    --ss-code-key: var(--ss-text-strong);
+    --ss-code-str: var(--ss-text);
+    --ss-code-num: var(--ss-text-strong);
+    --ss-code-fn: var(--ss-text-strong);
+  }
+
+  /* Lines not yet shown are laid out but hidden, so streaming never reflows */
+  .ss-code__line {
+    display: flex;
+    padding-right: 12px;
+    opacity: 0;
+    transition: opacity 0.3s ease;
+  }
+
+  .ss-code__line[data-on] {
+    opacity: 1;
+  }
+
+  .ss-code__num {
+    flex-shrink: 0;
+    width: 30px;
+    padding-right: 10px;
+    text-align: right;
+    font-variant-numeric: tabular-nums;
+    color: var(--ss-text-faint);
+  }
+
+  /* Wide enough that the + or − stands clear of the code after it */
+  .ss-code__mark {
+    flex-shrink: 0;
+    width: 16px;
+    color: var(--ss-text-faint);
+  }
+
+  .ss-code__text {
+    flex: 1;
+    min-width: 0;
+    overflow: hidden;
+    white-space: pre;
+  }
+
+  /* A line longer than the block fades at its right edge, never cut hard;
+     the diff tint behind it still runs the full width */
+  .ss-code__text[data-over] {
+    mask-image: linear-gradient(to right, #000 calc(100% - 14px), transparent);
+  }
+
+  .ss-code__line[data-kind="add"] { background: var(--ss-success-soft); }
+
+  .ss-code__line[data-kind="add"] .ss-code__mark { color: var(--ss-success-text); }
+
+  .ss-code__line[data-kind="del"] { background: var(--ss-danger-soft); }
+
+  .ss-code__line[data-kind="del"] .ss-code__mark { color: var(--ss-danger-text); }
+
+  .ss-code__key { color: var(--ss-code-key); }
+
+  .ss-code__str { color: var(--ss-code-str); }
+
+  .ss-code__num + .ss-code__mark + .ss-code__text .ss-code__num,
+  .ss-code__text .ss-code__num { width: auto; padding: 0; text-align: inherit; color: var(--ss-code-num); }
+
+  .ss-code__fn { color: var(--ss-code-fn); }
+
+  .ss-code__com { color: var(--ss-text-faint); }
+}
diff --git a/frontend/src/stageshow/code.tsx b/frontend/src/stageshow/code.tsx
new file mode 100644
index 0000000..37ef44d
--- /dev/null
+++ b/frontend/src/stageshow/code.tsx
@@ -0,0 +1,70 @@
+import { useLayoutEffect, useRef, type CSSProperties, type ReactNode } from 'react'
+import './code.css'
+
+// Code as the subject: real lines in a monospace block with line numbers,
+// quiet syntax color, and diff lines that read at a glance.
+
+export interface CodeLine {
+  text: string
+  /** add: a green line with a +. del: a red line with a −. */
+  kind?: 'add' | 'del'
+  /** false leaves this line's number blank (a wrapped continuation, a fold). */
+  number?: boolean
+}
+
+const KEYWORDS = /^(const|let|var|function|return|if|else|await|async|import|from|export|default|new|true|false|null|undefined|for|of|in|while|try|catch|throw|class|extends|type|interface|def|self|None|True|False)$/
+
+/** A light tokenizer: comments, strings, numbers, keywords, function calls. */
+function tokens(line: string): ReactNode[] {
+  const out: ReactNode[] = []
+  const re = /(\/\/.*$|#.*$)|('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*"|`(?:[^`\\]|\\.)*`)|(\b\d[\d._]*\b)|([A-Za-z_$][\w$]*)(?=\s*\()|([A-Za-z_$][\w$]*)/g
+  let last = 0
+  let m: RegExpExecArray | null
+  let k = 0
+  while ((m = re.exec(line))) {
+    if (m.index > last) out.push(line.slice(last, m.index))
+    const [text, com, str, num, call, word] = m
+    const kind = com ? 'com' : str ? 'str' : num ? 'num' : call ? (KEYWORDS.test(call) ? 'key' : 'fn') : word && KEYWORDS.test(word) ? 'key' : null
+    out.push(kind ? <span key={k++} className={`ss-code__${kind}`}>{text}</span> : text)
+    last = m.index + text.length
+  }
+  if (last < line.length) out.push(line.slice(last))
+  return out
+}
+
+/**
+ * Lines of code. `count` shows only the first n lines, the rest laid out but
+ * hidden, so a block can stream in (a build log, a generated function) without
+ * anything reflowing. Diff lines get a tint and a + or − in the gutter.
+ */
+export function Code({ lines, start = 1, numbers = true, count, highlight = true, className, style }: { lines: (CodeLine | string)[]; start?: number; numbers?: boolean; count?: number; highlight?: boolean; className?: string; style?: CSSProperties }) {
+  let n = start
+  // Only lines that really run past the block fade at the edge
+  const ref = useRef<HTMLDivElement>(null)
+  useLayoutEffect(() => {
+    const mark = () =>
+      ref.current?.querySelectorAll<HTMLElement>('.ss-code__text').forEach((t) => {
+        t.toggleAttribute('data-over', t.scrollWidth > t.clientWidth + 1)
+      })
+    mark()
+    const ro = new ResizeObserver(mark)
+    if (ref.current) ro.observe(ref.current)
+    return () => ro.disconnect()
+  })
+  return (
+    <div ref={ref} className={`ss-code${className ? ` ${className}` : ''}`} style={style}>
+      {lines.map((raw, i) => {
+        const line = typeof raw === 'string' ? { text: raw } : raw
+        // A removed line keeps the old number; the line after it reuses it
+        const num = line.kind === 'del' || line.number === false ? n : n++
+        return (
+          <div key={i} className="ss-code__line" data-kind={line.kind} data-on={count === undefined || i < count || undefined}>
+            {numbers && <span className="ss-code__num">{line.kind === 'del' || line.number === false ? '' : num}</span>}
+            <span className="ss-code__mark">{line.kind === 'add' ? '+' : line.kind === 'del' ? '−' : ''}</span>
+            <span className="ss-code__text">{highlight ? tokens(line.text) : line.text}</span>
+          </div>
+        )
+      })}
+    </div>
+  )
+}
diff --git a/frontend/src/stageshow/controls/Badge.css b/frontend/src/stageshow/controls/Badge.css
new file mode 100644
index 0000000..5d00dc6
--- /dev/null
+++ b/frontend/src/stageshow/controls/Badge.css
@@ -0,0 +1,56 @@
+/* Badge */
+
+@layer stageshow {
+  /* Small boxes with text keep a layer of their own. Pushed by a row opening
+     above them, or carried along by anything that moves by layout, their text
+     would step whole pixels while the fill glides, and hop about inside it */
+  .ss-badge {
+    will-change: transform;
+  }
+
+  .ss-badge {
+    display: inline-flex;
+    align-items: center;
+    gap: 5px;
+    height: 20px;
+    padding: 0 9px;
+    border-radius: var(--ss-radius-pill);
+    background: var(--ss-ink-2);
+    font-size: 11px;
+    font-weight: 500;
+    color: var(--ss-text-strong);
+    white-space: nowrap;
+    /* A tone change (Working to Ready) eases on the same pill, no swap */
+    transition: background-color 0.35s ease, color 0.35s ease;
+  }
+
+  /* A round mark before the words reads as further in than text does, so
+     its side is 2px tighter: the dot and the last letter then sit the same
+     distance from their ends */
+  .ss-badge[data-lead] {
+    padding-left: 7px;
+  }
+
+  .ss-badge[data-tone="accent"] { background: var(--ss-accent-soft); color: var(--ss-accent-text); }
+
+  .ss-badge[data-tone="success"] { background: var(--ss-success-soft); color: var(--ss-success-text); }
+
+  .ss-badge[data-tone="danger"] { background: var(--ss-danger-soft); color: var(--ss-danger-text); }
+
+  .ss-badge[data-tone="warning"] { background: var(--ss-warning-soft); color: var(--ss-warning-text); }
+
+  /* The label's line box trimmed to cap height and baseline, so the words
+     center on their own ink; a plain line box keeps descender room and sits
+     the text about 2px low in a 20px pill */
+  .ss-badge__label {
+    display: block;
+    text-box: trim-both cap alphabetic;
+  }
+
+  .ss-badge__dot {
+    width: 6px;
+    height: 6px;
+    border-radius: 50%;
+    background: currentColor;
+  }
+}
