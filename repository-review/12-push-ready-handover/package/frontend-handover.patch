+import { cn } from "../../lib/cn";
+
+/**
+ * ShimmerButton — Magic UI-style CTA with a slow, tasteful highlight sweep.
+ * Renders an anchor or button; the sweep is pure CSS (transform only).
+ */
+export default function ShimmerButton({
+  children,
+  as: Component = "button",
+  className,
+  ...props
+}) {
+  return (
